<?xml version="1.0" encoding="utf-8"?>
<!-- Clean's own mark: a dumbbell seen from the side, framed by an open ring that reads as a C. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- The C: three quarters of a ring, open to the right. -->
    <path
        android:pathData="M73.1,34.9 A27,27 0 1,0 73.1,73.1"
        android:strokeColor="#EB4F55"
        android:strokeWidth="8"
        android:strokeLineCap="round" />
    <!-- The bar. -->
    <path
        android:pathData="M38,54 L70,54"
        android:strokeColor="#F2F3F5"
        android:strokeWidth="4"
        android:strokeLineCap="round" />
    <!-- The inner, larger plates. -->
    <path
        android:pathData="M45,45 L45,63 M63,45 L63,63"
        android:strokeColor="#F2F3F5"
        android:strokeWidth="5.5"
        android:strokeLineCap="round" />
    <!-- The outer, smaller plates. -->
    <path
        android:pathData="M39,49 L39,59 M69,49 L69,59"
        android:strokeColor="#F2F3F5"
        android:strokeWidth="4.5"
        android:strokeLineCap="round" />
</vector>
