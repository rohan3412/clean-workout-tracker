<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only for the buzz at the end of a rest; the app still asks for no network access. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Only for Settings, Workout, "Alert when the app is in the background": an alarm on the phone five seconds before a rest ends, and the notification it shows. Nothing here goes online. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Writing (never reading) workouts and weigh-ins to Health Connect, the store on the phone that health apps share. Asked for only when the user switches it on. -->
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Clean">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="uiMode"
            android:screenOrientation="portrait"
            android:label="@string/app_name"
            android:theme="@style/Theme.Clean"
            android:windowSoftInputMode="adjustResize">
            <!-- Links from other apps: clean://start, clean://start?template=Name, clean://open?tab=history. Nothing here goes online. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="clean" />
            </intent-filter>
            <!-- A Clean templates file opened from a file manager or sent from a chat app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="application/json" />
            </intent-filter>
            <!-- Health Connect asks every app that writes to it for a page saying why; it opens the app, where Settings, Data says it. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Every icon alias opens this, which hands over to MainActivity at once (Launch.kt): a task begun by an alias is closed by Android when the alias is switched off. -->
        <activity
            android:name=".Launch"
            android:exported="false"
            android:taskAffinity="clean.app.launch"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

