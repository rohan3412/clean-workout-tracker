<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- What the window shows before the app has drawn anything: the light theme's background. -->
    <style name="Theme.Clean" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>

    <!-- Dialogs, sheets and the phone's pickers blink in and out in place (Motion.windowAnimation); with animations off they cut. -->
    <style name="BlinkWindow">
        <item name="android:windowEnterAnimation">@anim/blink_in</item>
        <item name="android:windowExitAnimation">@anim/blink_out</item>
    </style>
    <style name="CutWindow">
        <item name="android:windowEnterAnimation">@null</item>
        <item name="android:windowExitAnimation">@null</item>
    </style>
</resources>
