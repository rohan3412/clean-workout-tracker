<?xml version="1.0" encoding="utf-8"?>
<!-- The Since last workout widget: two cells wide, one tall, stretchable, redrawn every half hour; with a description and a preview for the widget picker. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_restdays_description"
    android:initialLayout="@layout/widget"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:previewLayout="@layout/widget_preview_restdays"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
